# Plantilla de secretos para despliegue en Streamlit Community Cloud.
#
# IMPORTANTE: NO subas este archivo con la API key real a GitHub.
# En Streamlit Cloud, configura los secretos desde la interfaz web:
#   App settings → Secrets → pega el contenido real sin el .example
#
# Localmente, renombra este archivo a 'secrets.toml' (sin .example)
# y pega tu API key real para probar.

LLM_API_KEY = "pega-aqui-tu-api-key-de-gemini"
LLM_MODELO = "gemini-2.0-flash-exp"
